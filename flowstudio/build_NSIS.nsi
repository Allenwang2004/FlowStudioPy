; Script generated by the HM NIS Edit Script Wizard.

; HM NIS Edit Wizard helper defines
!define PRODUCT_NAME "Flow Studio Pro"
!define PRODUCT_VERSION 2.3.4-pro
!define PRODUCT_PUBLISHER "Tymphany"
!define PRODUCT_WEB_SITE "http://www.tymphany.com"
!define PRODUCT_DIR_REGKEY "Software\Microsoft\Windows\CurrentVersion\App Paths\main.exe"
!define PRODUCT_INSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Install\${PRODUCT_NAME}"
!define PRODUCT_UNINST_KEY "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\${PRODUCT_NAME}"

; MUI 1.67 compatible ------
!include "MUI.nsh"
!include "nsDialogs.nsh"
!include "LogicLib.nsh"

; MUI Settings
!define MUI_ABORTWARNING
!define MUI_ICON "..\resources\main-theme.ico"

; Welcome page
!insertmacro MUI_PAGE_WELCOME
; License page
!insertmacro MUI_PAGE_LICENSE "..\License.txt"
; Privacy Policy page
Page custom PrivacyPolicyPage PrivacyPolicyPageLeave
; Directory page
!insertmacro MUI_PAGE_DIRECTORY
; Instfiles page
!insertmacro MUI_PAGE_INSTFILES

; Language files
!insertmacro MUI_LANGUAGE "English"

; MUI end ------

Name "${PRODUCT_NAME} ${PRODUCT_VERSION}"
OutFile "Flow Studio 2.3.4-pro Pro.exe"
!define MUI_PAGE_CUSTOMFUNCTION_show Pageshow 
InstallDir "C:\FlowStudio_Pro"
InstallDirRegKey HKCU "Software\FlowStudioPro" "" 
ShowUnInstDetails  show
ShowInstDetails show

    Var Dialog
    Var LinkLabel
    Var CheckBox
    
        Function OpenPrivacyPolicy
            ExecShell "open" "https://beta.tymecho.com/#/privacyPolicy"
        FunctionEnd

        Function PrivacyPolicyPage
            !insertmacro MUI_HEADER_TEXT "Privacy Policy" "Please read our privacy policy to continue."

            nsDialogs::Create 1018
            Pop $Dialog

            ${If} $Dialog == error
                Abort
            ${EndIf}

            ${NSD_CreateLabel} 0 0 100% 30u "Please visit the following link to read our Privacy Policy:"
            Pop $0

            ${NSD_CreateLink} 0 35u 100% 15u "https://beta.tymecho.com/#/privacyPolicy"
            Pop $LinkLabel
            ${NSD_OnClick} $LinkLabel OpenPrivacyPolicy

            ${NSD_CreateLabel} 0 60u 100% 30u "After you have read the Privacy Policy, please check the box below to continue with the installation."
            Pop $0

            ${NSD_CreateCheckbox} 0 100u 100% 15u "I have read and accept the Privacy Policy"
            Pop $CheckBox

            nsDialogs::Show
        FunctionEnd

        Function PrivacyPolicyPageLeave
            ${NSD_GetState} $CheckBox $0
            ${If} $0 != ${BST_CHECKED}
                MessageBox MB_ICONEXCLAMATION "You must accept the Privacy Policy to continue the installation."
                Abort
            ${EndIf}
        FunctionEnd
        


