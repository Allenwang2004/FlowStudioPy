       <property name="styleSheet">
        <string notr="true">QDialogButtonBox {
    button-layout: 0;
}

QPushButton{
	font: 75 9pt &quot;Calibri&quot;;
	font-weight: bold;
    background: gray;
    color: white;

	border-radius: 0px;
    
	width: 120px;
	height: 20px;
    padding: 5px;
}

QPushButton:disabled {
	background:  #595959;
	color: gray;
}

QPushButton:enabled {
    background: gray;
    color: white;
}

QPushButton:hover {
	background: gray;
	color: black;
}

QPushButton:pressed {
	background: lightgray;
	color: black;
	border-width: 3px;
	border-style: solid;
	border-color: gray;
}
</string>
